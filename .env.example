# --- Server ---
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# --- PostgreSQL ---
# Either set DATABASE_URL, or the discrete PG_* vars below.
DATABASE_URL=postgres://invoicepro_user:invoicepro_pass@localhost:5432/invoicepro_ng
PGSSL=false

# --- Auth / JWT ---
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Email (Resend or SMTP via Nodemailer) ---
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="InvoicePro NG <no-reply@invoicepro.ng>"

# --- Payscribe ---
PAYSCRIBE_BASE_URL=https://api.payscribe.ng
PAYSCRIBE_SECRET_KEY=
PAYSCRIBE_PUBLIC_KEY=
PAYSCRIBE_WEBHOOK_SECRET=

# --- 2FA ---
TOTP_ISSUER=InvoicePro NG

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# --- PostHog (product analytics) ---
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
