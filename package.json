{
  "name": "invoicepro-ng-backend",
  "version": "0.1.0",
  "description": "Backend API for InvoicePro NG — mobile-first invoicing & payment collection platform for Nigerian freelancers and SMEs",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create",
    "test": "jest --runInBand"
